{
  "name": "gridstator-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter ./apps/vscode build",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.tests.json --pretty && tsc -p apps/vscode/tsconfig.json && tsc -p apps/vscode/webview/tsconfig.json && tsc -p apps/vscode/test/tsconfig.json && pnpm desktop:typecheck",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test:ui": "pnpm build && pnpm --filter ./apps/vscode exec playwright test",
    "test:vscode": "pnpm build && cd apps/vscode && GRIDSTATOR_NATIVE_CLI_E2E=\"$PWD/../../native/target/debug/gridstator\" xvfb-run -a node test/run-integration.mjs",
    "package:vscode": "pnpm build && pnpm --filter ./apps/vscode package",
    "desktop:resources": "node scripts/desktop-artifacts.mjs stage",
    "desktop:dev": "pnpm desktop:resources && pnpm --filter @gridstator/desktop desktop:dev",
    "desktop:build": "node scripts/build-desktop-installers.mjs",
    "desktop:installer": "pnpm desktop:build",
    "desktop:typecheck": "pnpm --filter @gridstator/desktop typecheck",
    "desktop:test:ui": "pnpm --filter @gridstator/desktop build && pnpm --filter @gridstator/desktop test:ui",
    "desktop:test:packaging": "node --test scripts/desktop-artifacts.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.19.2",
    "esbuild": "~0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.1.0"
  },
  "version": "2.0.0-dev.2"
}
