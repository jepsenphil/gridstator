{
  "name": "gridstator-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf apps/cli/release",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.tests.json --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && GRIDSTATOR_E2E=1 vitest run --config vitest.e2e.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bundle": "pnpm build && pnpm --filter gridstator bundle",
    "gridstator": "node apps/cli/dist/main.js",
    "pack:release": "pnpm bundle && cd apps/cli/release && npm pack",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.19.2",
    "esbuild": "~0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.1.0"
  }
}
